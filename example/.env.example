# Ключ шифрування сховища (мінімум 16 символів).
# Можна згенерувати в main.py (пункт меню [9]) або через CLI: gemini-webapi-manager keygen
GEMINI_MANAGER_KEY="your-secret-vault-key-min-16-chars"

# Локальний шлях до директорії сховища vault.bin.
# Якщо не вказано, main.py автоматично використовує теку ./data поруч із файлом main.py
GEMINI_MANAGER_HOME="./data"

# Максимальна кількість слотів (за замовчуванням: 10)
GEMINI_MANAGER_MAX_SLOTS="10"
