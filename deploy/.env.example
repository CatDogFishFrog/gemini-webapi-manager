# Скопіюйте в .env (cp .env.example .env) і заповніть. Файл .env у git не потрапляє.

# ОБОВ'ЯЗКОВО: ключ шифрування vault.bin (мін. 16 символів). Згенерувати:
#   docker compose run --rm --no-deps --entrypoint gemini-vault gateway keygen
# Збережіть його окремо: без ключа vault.bin не відкрити.
GEMINI_MANAGER_KEY=

# Ключі, з якими клієнти звертаються до шлюзу (Authorization: Bearer <ключ>), через кому.
# Без них шлюз відкритий для кожного, хто досягне його порту.
GEMINI_GATEWAY_API_KEYS=

# Необов'язково: куди публікувати порт на хості (типово лише локально, порт 8080).
# GATEWAY_BIND=127.0.0.1
# GATEWAY_PORT=8080
